<Page x:Class="gas_appliances.Pages.PageEditOwner"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:gas_appliances.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageEditOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="430"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" VerticalAlignment="Center">
            <MenuItem Header="Назад" Click="MenuItem_Click"/>
            <MenuItem Name="menuDel" Header="Удалить" Click="menuDel_Click"/>
        </Menu>

        <StackPanel Margin="10" Grid.Row="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Имя:" Width="150" VerticalAlignment="Center"/>
                <TextBox Name="txbOwnerName" Width="250" Margin="5, 5, 0, 5"
                         Text="{Binding OwnerName, Mode=OneWay}" MaxLength="100"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Контактная информация:" Width="150" 
                           VerticalAlignment="Center"/>
                <TextBox Name="txbContactInfo" Width="250" Margin="5, 5, 0, 5"
                         Text="{Binding ContactInfo, Mode=OneWay}" MaxLength="100"/>
            </StackPanel>

            <Button Name="btnSave" Content="Сохранить" Click="btnSave_Click"
                    Width="75">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="7"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Page>
