<Page x:Class="gas_appliances.Pages.PageManufacturers"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:gas_appliances.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageManufacturers">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="50"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Name="menuAddManufacturer" Header="Добавить" 
                      Click="menuAddManufacturer_Click"/>
            <!--<MenuItem Name="menuReport" Header="Отчет"
              Click="menuReport_Click"/>-->
            <MenuItem Name="menuLogOut" Header="Выход"
                      Click="menuLogOut_Click"/>
        </Menu>
        <StackPanel Orientation="Horizontal" Grid.Row="1" 
                    VerticalAlignment="Center">
            <Label Content="Поиск:"/>
            <TextBox Width="150" Height="25" Margin="10, 0"
                     Name="txbSearchManufacturers" 
                     TextChanged="txbSearchManufacturers_TextChanged"/>
            <ComboBox Height="25" Width="150" Name="cmbType"
                      SelectionChanged="cmbType_SelectionChanged"/>
            <Button Height="25" Width="75" Name="btnRefresh"
                    Content="Обновить" Click="btnRefresh_Click"
                    Margin="10, 0"/>
        </StackPanel>

        <DataGrid Name="dgrManufacturers" Grid.Row="2" 
                  AutoGenerateColumns="False" IsReadOnly="True" 
                  MouseDoubleClick="dgrManufacturers_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Наименование" 
                                    Binding="{Binding ManufacturerName}" 
                                    Width="*"/>
                <DataGridTemplateColumn Header="Тип" Width="auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock DataContext="{Binding Path=ToolManufacturerType}">
                                <TextBlock.Text>
                                    <Binding Path="ManufacturerTypeName"/>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Контактная информация" 
                                    Binding="{Binding ContactInfo}"
                                    Width="*"/>
                <DataGridTextColumn Header="Имя представителя" 
                                    Binding="{Binding RepresentativeName}" 
                                    Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
