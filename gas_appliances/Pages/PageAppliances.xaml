<Page x:Class="gas_appliances.Pages.PageAppliances"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:gas_appliances.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageAppliances">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Name="menuAddAppliance" Header="Добавить" 
                      Click="menuAddAppliance_Click"/>
            <MenuItem Name="menuReport" Header="Отчет"
                      Click="menuReport_Click"/>
            <MenuItem Name="menuLogOut" Header="Выход"
                      Click="menuLogOut_Click"/>
        </Menu>
        
        <StackPanel Orientation="Horizontal" Grid.Row="1" 
                    VerticalAlignment="Center">
            <Label Content="Поиск:"/>
            <TextBox Width="150" Height="25" Margin="10, 0"
                     Name="txbSearchAppliances" 
                     TextChanged="txbSearchAppliances_TextChanged"/>
            <TextBox Width="150" Height="25" Margin="0, 0, 10, 0"
                     Name="txbSearchAppliancesSN" 
                     TextChanged="txbSearchAppliancesSN_TextChanged"/>
            <TextBox Width="150" Height="25" Margin="0, 0, 10, 0"
                     Name="txbSearchOwners" 
                     TextChanged="txbSearchOwners_TextChanged"/>
            <ComboBox Height="25" Width="150" Name="cmbCategory"
                      SelectionChanged="cmbCategory_SelectionChanged"/>
            <ComboBox Height="25" Width="150" Name="cmbStatus"
                      SelectionChanged="cmbStatus_SelectionChanged"
                      Margin="10, 0"/>
            <Button Height="25" Width="75" Name="btnRefresh"
                    Content="Обновить" Click="btnRefresh_Click"/>
        </StackPanel>
        
        <StackPanel Orientation="Horizontal" Grid.Row="2" VerticalAlignment="Center">
            <Label Content="В экспл. с"/>
            <DatePicker Width="150" Height="25" Margin="10, 0" 
                        Name="dpInstalledSinceStart" 
                        SelectedDateChanged="dpInstalledSinceStart_SelectedDateChanged"
                        PreviewTextInput="dpInstalledSinceStart_PreviewTextInput"/>
            <Label Content="до"/>
            <DatePicker Width="150" Height="25" Margin="10, 0" 
                        Name="dpInstalledSinceEnd" 
                        SelectedDateChanged="dpInstalledSinceEnd_SelectedDateChanged"
                        PreviewTextInput="dpInstalledSinceEnd_PreviewTextInput"/>
            <Label Content="След. проверка с"/>
            <DatePicker Width="150" Height="25" Margin="10, 0" 
                        Name="dpNextExaminationStart" 
                        SelectedDateChanged="dpNextExaminationStart_SelectedDateChanged"
                        PreviewTextInput="dpNextExaminationStart_PreviewTextInput"/>
            <Label Content="до"/>
            <DatePicker Width="150" Height="25" Margin="10, 0" 
                        Name="dpNextExaminationEnd" 
                        SelectedDateChanged="dpNextExaminationEnd_SelectedDateChanged"
                        PreviewTextInput="dpNextExaminationEnd_PreviewTextInput"/>
        </StackPanel>
                          
        <DataGrid Name="dgrAppliances" Grid.Row="3" 
                  AutoGenerateColumns="False" IsReadOnly="True" 
                  MouseDoubleClick="dgrAppliances_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Категория" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock DataContext="{Binding Path=Category}">
                                <TextBlock.Text>
                                    <Binding Path="CategoryName"/>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Прибор" Binding="{Binding ApplianceName}"
                                    Width="*"/>
                    <DataGridTemplateColumn Header="Статус" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock DataContext="{Binding Path=Statuses}">
                                    <TextBlock.Text>
                                        <Binding Path="StatusName"/>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Владелец" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock DataContext="{Binding Path=Owners}">
                                    <TextBlock.Text>
                                        <Binding Path="OwnerName"/>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="В экспл." 
                                        Binding="{Binding InstalledSince, StringFormat=d}" 
                                        Width="auto"/>
                    <DataGridTextColumn Header="След. поверка" 
                                        Binding="{Binding NextExamination, StringFormat=d}"
                                        Width="auto"/>
                    <DataGridTextColumn Header="Серийный номер" 
                                        Binding="{Binding SerialNumber}"
                                        Width="*"/>
                    <DataGridTextColumn Header="Заметки" 
                                        Binding="{Binding Notes}"
                                        Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
