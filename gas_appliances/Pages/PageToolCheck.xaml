<Page x:Class="gas_appliances.Pages.PageToolCheck"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:gas_appliances.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageToolCheck">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="50"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Name="menuAddExam" Header="Добавить" 
              Click="menuAddExam_Click"/>
            <MenuItem Name="menuLogOut" Header="Выход"
              Click="menuLogOut_Click"/>
        </Menu>

        <StackPanel Orientation="Horizontal" Grid.Row="1" 
            VerticalAlignment="Center">
            <Button Height="25" Width="75" Name="btnRefresh"
            Content="Обновить" Click="btnRefresh_Click"/>
        </StackPanel>

        <DataGrid Name="dgrToolExam" Grid.Row="2" 
          AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Проверяющий" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock DataContext="{Binding Path=Users}">
                                <TextBlock.Text>
                                    <Binding Path="FullName"/>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Инструмент" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock DataContext="{Binding Path=Tool}">
                                <TextBlock.Text>
                                    <Binding Path="ModelName"/>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Дата проверки" 
                            Binding="{Binding CheckDate, StringFormat=d}"
                            Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
